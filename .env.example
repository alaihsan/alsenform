APP_NAME="Falcon Forms"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=http://falcon.intranet:2026
# Alamat intranet yang dibuka siswa (php artisan lan:serve, port 2026). Router harus punya DNS statis nama ini -> IP server.
LAN_HOST=falcon.intranet
# Di belakang Caddy (satu server untuk beberapa aplikasi web): isi 80 (atau 443 untuk HTTPS) dan
# APP_URL=http://falcon.intranet; situs Caddy-nya dibuat oleh php artisan lan:caddy. Kosong: siswa membuka port 2026 langsung.
LAN_PUBLIC_PORT=
# Supaya "php artisan serve" juga terbuka di jaringan pada port 2026, bukan localhost:8000. Untuk ujian, pakai php artisan lan:serve.
SERVER_HOST=0.0.0.0
SERVER_PORT=2026

# Expose / Herd running on this machine are always trusted. Add other proxy IPs (comma separated) if needed.
TRUSTED_PROXIES=

APP_LOCALE=en
APP_DISPLAY_TIMEZONE=Asia/Jakarta
# Email atau nomor yang ditampilkan di halaman Kebijakan Privasi untuk pertanyaan tentang data
PRIVACY_CONTACT=
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=10

LOG_CHANNEL=stack
LOG_STACK=daily
# Satu berkas log per hari (storage/logs/laravel-YYYY-MM-DD.log), disimpan 14 hari.
LOG_DAILY_DAYS=14
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# Backup database di storage/app/backups (php artisan db:backup; lan:serve membuatnya otomatis setiap hari).
BACKUP_KEEP=14
# Bila pg_dump tidak ada di PATH (Herd, Postgres.app), isi path lengkapnya:
# BACKUP_PG_DUMP=/Applications/Postgres.app/Contents/Versions/latest/bin/pg_dump
# Lama data Laporan Aktivitas dan salinan jawaban selama ujian disimpan (hari).
ACTIVITY_LOG_DAYS=365
DRAFT_SNAPSHOT_DAYS=90

DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=alsenform
DB_USERNAME=postgres
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"
